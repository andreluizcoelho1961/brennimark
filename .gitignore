# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/test-results/
e2e/fixtures/mil-paginas.pdf
e2e/fixtures/mil-e-uma-paginas.pdf
# Fixtures de escala da Fatia 1: ~100 MiB, reconstruídas por
# scripts/gerar-fixture-escala.py. O gerador se versiona; o PDF, nunca.
/.fixtures-grandes/
/.diag/
/coverage
/.tmp/
/brennimark/imports/
/e2e/.artefatos/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Material da bancada local: fixtures servidas ao navegador para o ciclo
# manual de importação. Nunca versionado — nem as sintéticas, para a pasta
# não virar um lugar onde material de cliente acaba entrando sem querer.
/public/.bancada/
e2e/fixtures/acima-do-teto.pdf
