{
  "name": "brennimark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "brennimark:references": "node scripts/index-brennimark-references.mjs",
    "test:brand-context": "rm -rf .tmp/brand-context-test && tsc -p tsconfig.tests.json && node --test \".tmp/brand-context-test/**/*.test.js\"",
    "evaluate:brand-chat": "node scripts/evaluate-brand-chat.mjs",
    "test:ci": "npm run test:brand-context",
    "verify": "npm run lint && npm run typecheck && npm run test:ci && npm run build && npm run test:e2e",
    "pretest:e2e": "npm run fixtures:pdf",
    "test:e2e": "playwright test",
    "fixtures:pdf": "python3 scripts/gerar-fixtures-pdf.py",
    "fixtures:escala": "python3 scripts/gerar-fixture-escala.py"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/groq": "^4.0.12",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@ai-sdk/react": "^4.0.34",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "ai": "^7.0.31",
    "fflate": "^0.8.3",
    "next": "^16.3.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
