# Variáveis de ambiente do Brennimark. Em produção moram SÓ na Vercel; localmente, em `.env.local`
# (que o git ignora). Este arquivo lista os NOMES e o que cada um faz — nunca valores reais.
# Atualizado em 09/11/2026 (auditoria): a era BYOK/GROQ saiu (ADR-0008) e as chaves de IA, do
# e-mail e da cobrança passaram a ter nomes próprios.

# ─── Supabase (obrigatório) ────────────────────────────────────────────────────
# Projeto oficial: `brennimark` (ref ijnpigdmlswhkxqbjeru, região sa-east-1).
# URL e chave pública (anon): seguras no navegador, por isso levam NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de SERVIÇO (secret key): ignora a RLS. Só no servidor — nunca com prefixo público, nunca num
# componente de cliente. Usada por `src/lib/supabase/service.ts` e pelas rotas públicas que o banco
# autoriza por conta própria (cadastro, webhook, links de entrega, limites de taxa).
SUPABASE_SECRET_KEY=

# ─── Limpeza periódica (produção) ──────────────────────────────────────────────
# Segredo do Vercel Cron: a Vercel o manda como `Authorization: Bearer ...` às rotas
# `/api/manutencao/*` (vercel.json). Sem ele, elas respondem 401 a tudo — inclusive ao próprio Cron.
# Mínimo de 16 caracteres; gere com `openssl rand -hex 32`.
CRON_SECRET=

# ─── IA da plataforma (ADR-0008) ───────────────────────────────────────────────
# Nenhuma conta escolhe ou configura IA: as rotas ficam no Console e a chave de cada provedor, aqui.
# A chave nunca vai ao banco nem a uma tela; o Console só mostra se ela existe. Preencha só os
# provedores que as rotas usam. Manual de cliente real nunca passa por chave de plano gratuito.
BRENNIMARK_CHAVE_GOOGLE=
BRENNIMARK_CHAVE_GROQ=
BRENNIMARK_CHAVE_ANTHROPIC=
BRENNIMARK_CHAVE_OPENAI=
BRENNIMARK_CHAVE_OPENROUTER=
BRENNIMARK_CHAVE_OLLAMA=
# Chave-mestra que cifra em repouso (AES-256-GCM) as chaves de IA antigas e as da IA própria da
# conta (ADR-0009). Não apague nem troque o valor: as chaves já guardadas deixariam de abrir.
AI_SETTINGS_ENCRYPTION_KEY=

# ─── Cobrança (Stripe) ─────────────────────────────────────────────────────────
# Chave secreta do Stripe (`sk_live_…` em produção, `sk_test_…` fora dela) e o segredo de assinatura
# do webhook (`whsec_…`): é ele que impede alguém de inventar um "pagamento confirmado".
BRENNIMARK_CHAVE_STRIPE=
BRENNIMARK_SEGREDO_WEBHOOK_STRIPE=

# ─── E-mail (Resend) ───────────────────────────────────────────────────────────
# Sem as duas, `emailConfigurado()` diz que não e as telas avisam que o e-mail não está ligado.
# O remetente precisa ser de um domínio verificado no serviço (ex.: `Brennimark <acesso@seudominio.com>`).
BRENNIMARK_CHAVE_EMAIL=
BRENNIMARK_EMAIL_REMETENTE=

# ─── Captcha (Cloudflare Turnstile) ────────────────────────────────────────────
# Segredo (servidor) e chave do site (pública) andam JUNTOS. Em produção, sem o segredo a entrada
# no tour fica indisponível (fecha, nunca abre); o cadastro gratuito só exige captcha quando as duas
# existem. Fora de produção usa-se a chave de teste pública da Cloudflare (aprova tudo).
BRENNIMARK_TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Brennimark Fonts ──────────────────────────────────────────────────────────
# Chave PRIVADA Ed25519 (PEM) que assina os certificados de licença do Brennimark Fonts. Só na
# Vercel; nunca no repositório, no banco ou numa tela. A pública está embutida no aplicativo:
# trocar a chave exige aplicativo novo. Quebras de linha podem vir como \n.
BRENNIMARK_CHAVE_LICENCAS_FONTS=

# ─── Limites da instalação ─────────────────────────────────────────────────────
# Teto de importação de PDF em MB (o do plano do Supabase, 50 no Free). O do produto é 100 MiB,
# constante no código; migrar ao Pro são dois passos: esta variável e uma migration no bucket.
NEXT_PUBLIC_TETO_DE_IMPORTACAO_MB=

# ─── Avaliação de qualidade do chat (opcional) ─────────────────────────────────
# Usadas apenas por `npm run evaluate:brand-chat`.
BRENNIMARK_BASE_URL=
BRENNIMARK_EVAL_CASES=
BRENNIMARK_EVAL_LIMIT=
BRENNIMARK_EVAL_REPORT=
# Libera avaliação contra um host que não seja localhost. Mantenha desligada.
BRENNIMARK_ALLOW_EXTERNAL_EVAL=

# ─── Desenvolvimento local apenas ──────────────────────────────────────────────
# Serve o conteúdo estático do guide sem login. O build de produção FALHA se esta flag estiver
# ligada. Definir só em .env.local.
BRENNIMARK_DEV_SKIP_AUTH=
