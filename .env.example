# ─── Instalação ────────────────────────────────────────────────────────────────
# Filtro temporário: quando definida, escolhe qual marca da conta este build
# serve. Vazia ou `unconfigured` = a primeira marca do workspace.
#
# Não é arquitetura definitiva. A marca ativa passa a ser escolhida em tempo de
# execução no patch 7, e então esta variável sai. Ver
# docs/plan/parecer-integracao-interface.md §5.2.
#
# Uma chave que não exista em src/brandville/instances/generated.ts derruba a
# aplicação na inicialização — resolveBrandvilleInstance lança exceção. O
# registro está vazio desde a remoção da herança, então deixe isto vazio.
NEXT_PUBLIC_BRANDVILLE_INSTANCE=

# ─── Supabase (obrigatório) ────────────────────────────────────────────────────
# Projeto oficial: `brennimark` (ref ijnpigdmlswhkxqbjeru, região sa-east-1).
# As chaves ficam no painel do projeto; nunca commitar valores reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Limpeza periódica (produção) ──────────────────────────────────────────────
# Segredo do Vercel Cron: a Vercel o manda como `Authorization: Bearer ...` ao
# chamar /api/manutencao/materiais-orfaos (vercel.json). Sem ele, a rota
# responde 401 a tudo — inclusive ao próprio Cron. Mínimo de 16 caracteres;
# gere com `openssl rand -hex 32`. A rota também exige SUPABASE_SECRET_KEY.
CRON_SECRET=

# ─── Criptografia (obrigatório) ────────────────────────────────────────────────
# Chave server-only usada para cifrar as chaves de IA (AES-256-GCM) em repouso.
# Sem ela o CRUD de BYOK não funciona. Nunca commitar o valor real.
AI_SETTINGS_ENCRYPTION_KEY=

# ─── IA: demonstração e fallback (opcional) ────────────────────────────────────
# Usada quando o workspace ainda não configurou uma chave própria (BYOK).
GROQ_API_KEY=
# Rota de reserva do chat quando a principal falha ou estoura o timeout do
# primeiro chunk. Os três valores andam juntos; deixe todos vazios para desligar.
AI_CHAT_FALLBACK_PROVIDER=
AI_CHAT_FALLBACK_MODEL=
AI_CHAT_FALLBACK_API_KEY=

# ─── Avaliação de qualidade do chat (opcional) ─────────────────────────────────
# Usadas apenas por `npm run evaluate:brand-chat`.
BRANDVILLE_BASE_URL=
BRANDVILLE_EVAL_CASES=
BRANDVILLE_EVAL_LIMIT=
BRANDVILLE_EVAL_REPORT=
# Libera avaliação contra um host que não seja localhost. Mantenha desligada.
BRANDVILLE_ALLOW_EXTERNAL_EVAL=

# ─── Desenvolvimento local apenas ──────────────────────────────────────────────
# Serve o conteúdo estático do guide sem login. Admin, histórico e assets
# privados continuam exigindo sessão. O build de produção FALHA se esta flag
# estiver ligada — apresentações comerciais usam uma instalação sanitizada com
# autenticação real, não esta variável. Definir só em .env.local.
BRANDVILLE_DEV_SKIP_AUTH=
