# ─── Instalação ────────────────────────────────────────────────────────────────
# Escolhe qual marca este build serve. Definida em build time.
# Valores disponíveis nesta matriz: the-bluesmaker | hairline | empresa-modelo | example
NEXT_PUBLIC_BRANDVILLE_INSTANCE=the-bluesmaker

# ─── Supabase (obrigatório) ────────────────────────────────────────────────────
# Cada instalação recebe seu próprio projeto e suas próprias chaves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Criptografia (obrigatório) ────────────────────────────────────────────────
# Chave server-only usada para cifrar as chaves de IA (AES-256-GCM) em repouso.
# Sem ela o CRUD de BYOK não funciona. Nunca commitar o valor real.
AI_SETTINGS_ENCRYPTION_KEY=

# ─── IA: demonstração e fallback (opcional) ────────────────────────────────────
# Usada quando o workspace ainda não configurou uma chave própria (BYOK).
GROQ_API_KEY=
# Rota de reserva do chat quando a principal falha ou estoura o timeout do
# primeiro chunk. Os três valores andam juntos; deixe todos vazios para desligar.
AI_CHAT_FALLBACK_PROVIDER=
AI_CHAT_FALLBACK_MODEL=
AI_CHAT_FALLBACK_API_KEY=

# ─── Avaliação de qualidade do chat (opcional) ─────────────────────────────────
# Usadas apenas por `npm run evaluate:brand-chat`.
BRANDVILLE_BASE_URL=
BRANDVILLE_EVAL_CASES=
BRANDVILLE_EVAL_LIMIT=
BRANDVILLE_EVAL_REPORT=
# Libera avaliação contra um host que não seja localhost. Mantenha desligada.
BRANDVILLE_ALLOW_EXTERNAL_EVAL=

# ─── Desenvolvimento local apenas ──────────────────────────────────────────────
# Serve o conteúdo estático do guide sem login. Admin, histórico e assets
# privados continuam exigindo sessão. O build de produção FALHA se esta flag
# estiver ligada — apresentações comerciais usam uma instalação sanitizada com
# autenticação real, não esta variável. Definir só em .env.local.
BRANDVILLE_DEV_SKIP_AUTH=
